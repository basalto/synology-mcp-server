# Copy to .env and fill in real values. Never commit .env.
# DSM WebAPI endpoint (NAS3). HTTP is fine on the LAN; DSM's cert is self-signed.
SYNOLOGY_URL=http://192.168.1.93:5000
SYNOLOGY_USERNAME=mcp-server
SYNOLOGY_PASSWORD=CHANGE_ME
# SYNO.API.Auth login API version (6 works on DSM 6.2+ through 7.x)
SYNOLOGY_AUTH_VERSION=6
# Optional: bearer token for the MCP endpoint itself. Empty = unauthenticated.
MCP_AUTH_TOKEN=
SYNOLOGY_REQUEST_TIMEOUT=15
SYNOLOGY_LOG_LEVEL=INFO
